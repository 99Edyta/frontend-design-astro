---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-main">
    <div class="hero-content">
      <h1>Empowering Your Business Growth</h1>

      <p>
        Discover tailored strategies and expert insights to take your business
        to the next level. Let us help you navigate challenges and achieve
        sustainable success.
      </p>

      <div class="hero-actions">
        <a href="#0" class="primary-button">Book a Meeting</a>
        <a href="#0" class="secondary-button">
          Learn More
          <span>→</span>
        </a>
      </div>
    </div>

    <div class="hero-image-wrapper">
      <Image class="hero-image" src={CEOImage} alt="CEO" />
    </div>
  </div>

  <div class="hero-services">
    <Services />
  </div>
</section>

<style>
  @layer components {
    .hero {
      background-color: #f3f4f6;
      padding: 2rem;
      position: relative;
      width: min(calc(100% - 3rem), 75rem);
      margin-inline: auto;
      margin-bottom: 4rem;
    }

    .hero-main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 30rem;
      background-color: #020812;
      color: white;
      overflow: hidden;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 4rem 3rem 6rem;
    }

    .hero-content h1 {
      max-width: 15ch;
      margin: 0;
      font-size: clamp(2rem, 3vw, 3rem);
      font-weight: 600;
      line-height: 1.05;
      letter-spacing: -0.035em;
    }

    .hero-content p {
      max-width: 28rem;
      margin: 1.25rem 0 1.5rem;
      color: #aeb5c0;
      font-size: 0.8rem;
      line-height: 1.6;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .hero-actions a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 2.5rem;
      padding-inline: 1rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 500;
      text-decoration: none;
    }

    .primary-button {
      background-color: #ffc433;
      color: #111;
    }

    .secondary-button {
      border: 1px solid #374151;
      background-color: transparent;
      color: white;
    }

    .hero-image-wrapper {
      position: relative;
      min-width: 0;
      min-height: 30rem;
      overflow: hidden;
    }

    .hero-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .hero-services {
      position: absolute;
      left: 50%;
      bottom: -3rem;
      z-index: 10;
      width: calc(100% - 6rem);
      transform: translateX(-50%);
    }

    @media (max-width: 64rem) {
      .hero-content {
        padding: 3rem 2rem 6rem;
      }

      .hero-services {
        width: calc(100% - 4rem);
      }
    }

    @media (max-width: 48rem) {
      .hero {
        width: 100%;
        margin-bottom: 0;
      }

      .hero-main {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .hero-content {
        padding: 3.5rem 1.5rem;
      }

      .hero-content h1 {
        font-size: clamp(2.25rem, 9vw, 3rem);
      }

      .hero-content p {
        max-width: 100%;
      }

      .hero-image-wrapper {
        min-height: 25rem;
      }

      .hero-services {
        position: relative;
        left: auto;
        bottom: auto;
        width: 100%;
        padding: 1rem;
        transform: none;
      }
    }
  }
</style>
