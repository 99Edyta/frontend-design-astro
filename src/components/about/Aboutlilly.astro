---
import arrowLeftIcon from "@icons/arrow-left.svg?url";
import lillyImg from "@data/images/lilly.webp?url";
import facebookIcon from "@icons/facebook.svg?url";
import instagramIcon from "@icons/instagram.svg?url";
---

<section>
  <button>
    <a href="../team"><img src={arrowLeftIcon} />Back to team</a>
  </button>
  <div class="about">
    <div class="person-image">
      <div class="greenbox">
        <img src={lillyImg} />
      </div>
      <div class="some">
        <img src={facebookIcon} />
        <img src={instagramIcon} />
      </div>
    </div>
    <div class="text-content">
      <div class="description">
        <h1>Lilly Victoria</h1>
        <h3>President</h3>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quae ratione
          voluptates porro exercitationem nam, veniam iusto sint! Perspiciatis
          blanditiis in quis voluptatibus eaque, aspernatur, molestiae debitis
          aliquam, sint recusandae laboriosam. Lorem ipsum dolor sit amet
          consectetur adipisicing elit. Similique quidem repudiandae inventore
          impedit assumenda, quisquam dolores quaerat dolorum. Earum non ab
          dolore aliquam sit fugit facere vitae maxime perspiciatis tempora?
        </p>
      </div>
      <div class="line"></div>
      <div class="experience">
        <h1>Past experience</h1>
        <p>
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Similique
          quidem repudiandae inventore impedit assumenda, quisquam dolores
          quaerat dolorum. Earum non ab dolore aliquam sit fugit facere vitae
          maxime perspiciatis tempora? Lorem ipsum dolor sit amet, consectetur
          adipisicing elit. Quae ratione voluptates porro exercitationem nam,
          veniam iusto sint! Perspiciatis blanditiis in quis voluptatibus eaque,
          aspernatur, molestiae debitis aliquam, sint recusandae laboriosam.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    margin: 30px auto;
    width: 1100px;
    justify-content: center;
    align-items: center;
  }

  button {
    display: flex;
    padding: 15px 30px;
    background-color: black;
    gap: 10px;
    border-radius: 42px;
    width: 200px;
    justify-content: center;
    margin-top: 30px;
  }
  button a {
    color: var(--color-on-ui-primary, #f9fafb);
    text-align: center;
    font-family: Lato;
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
    line-height: 160%;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  button img {
    width: 20px;
    height: 10px;
    color: #f9fafb;
    width: 13px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
  }
  .about img {
    width: 300px;
    height: 350px;
    border-radius: 20px;
  }
  .about {
    display: flex;
    width: 1100px;
    align-items: flex-start;
    gap: 89px;
    margin-top: 100px;
  }
  h1 {
    font-family: Cabin;
    font-size: 30px;
    font-style: normal;
    font-weight: 700;
    line-height: 116%;
  }
  h3 {
    font-family: Cabin;
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: 116%;
  }
  p {
    font-family: Lato;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 147.5%;
    width: 633px;
  }
  .description,
  .experience {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
  }
  .some {
    display: flex;
    align-items: center;
    gap: 29px;
  }
  .some img {
    width: 30px;
    height: 30px;
    margin-bottom: 10px;
  }
  .person-image {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }
  .text-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .line {
    display: flex;
    width: 633px;
    height: 1px;
    background: #c1c1c1;
  }
  .greenbox {
    position: relative;
    width: 300px;
    height: 350px;
  }

  .greenbox::before {
    content: "";
    position: absolute;
    left: -53.1px;
    top: -40.672px;
    width: 233px;
    height: 164px;
    background-color: #a4eda4;
    border-radius: 20px;
    z-index: 0;
  }

  .greenbox img {
    position: relative;
    z-index: 1;
    display: block;
  }
</style>
