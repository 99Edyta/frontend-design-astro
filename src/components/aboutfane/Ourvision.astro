---
import checkmarkIcon from "@icons/checkmark.svg?url";
import storyboardImg from "@data/images/storyboard.webp?url";
---

<section>
  <div class="content">
    <div class="textbox">
      <div class="ourvision">
        <div class="overskrift">
          <h3>OUR VISION</h3>
        </div>
        <div class="underoverskrift">
          <h1>Turn your ideas into reality.</h1>
        </div>
        <div class="text">
          <p>
            Capitalize on low hanging fruit to identify a ballpark value added
            activity beta test. Override the digital divide with additional from
            DevOps.
          </p>
        </div>
      </div>
      <div class="checkmarks">
        <img src={checkmarkIcon} />
        <p>
          Bring to the table win-win survival strategies to ensure proactive
          domination. At the end of the day.
        </p>
      </div>

      <div class="checkmarks">
        <img src={checkmarkIcon} />
        <p>
          Capitalize on low hanging fruit to identify a ballpark value added
          activity to beta test override the digital.
        </p>
      </div>
    </div>
    <div class="billede">
      <img src={storyboardImg} />
      <div class="greenbox"></div>
    </div>
  </div>
</section>

<style>
  .content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 110px;
    width: 80%;
    margin: 100px auto;
  }
  .ourvision div {
    width: 70%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: auto;
    gap: 122px;
    margin: 0;
  }
  .textbox {
    display: flex;
    width: 590px;
    flex-direction: column;
    align-items: flex-start;
    gap: 19px;
  }
  .overskrift {
    color: #030712;
    text-align: flex-start;
    font-family: Lato;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 147.5%; /* 23.6px */
    letter-spacing: 2.32px;
    text-transform: uppercase;
  }
  .ourvision .overskrift {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-self: flex-start;
    margin-top: -30px;
    gap: 0;
  }

  .overskrift h3 {
    margin: 0;
  }
  .underoverskrift {
    color: #030712;
    font-family: Cabin;
    font-size: 35px;
    font-style: normal;
    font-weight: 500;
    line-height: 116%;
  }
  .ourvision .underoverskrift {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    margin: 0;
    gap: 0;
  }

  .underoverskrift h1 {
    margin: 0;
  }
  .text {
    color: #030712;
    font-family: Lato;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 147.5%;
    width: 590px;
  }
  .checkmarks {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .billede {
    position: relative;
  }
  .billede img {
    width: 700px;
    height: 400px;
    border-radius: 42px;
    position: relative;
    z-index: 1;
    display: block;
  }
  .greenbox {
    position: absolute;
    top: -30px;
    right: -30px;
    z-index: 0;
    width: 140px;
    height: 130px;
    border-radius: 20px;
    background: var(--color-ui-secondary, #a4eda4);
  }
</style>
